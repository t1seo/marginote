{
  "name": "obsidian-marginote",
  "version": "0.1.0",
  "private": true,
  "description": "Connected Markdown text and image cards in Obsidian.",
  "main": "main.js",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "https://github.com/t1seo/marginote.git"
  },
  "scripts": {
    "dev": "bun run esbuild.config.mjs --watch",
    "typecheck": "bun node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "bun run typecheck && bun run esbuild.config.mjs",
    "test": "bun test tests",
    "check": "bun run lint && bun run test && bun run build",
    "lint:obsidian": "bun run --bun eslint src package.json --max-warnings 0",
    "validate:release": "bun run scripts/release/validate.ts",
    "check:release": "bun run check && bun run lint:obsidian && bun run validate:release"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/bun": "1.4.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.13.1",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
